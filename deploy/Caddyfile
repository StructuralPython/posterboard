# Caddy in front of Posterboard. bunny.net terminates TLS and forwards plain HTTP
# to this port, so Caddy never manages certificates.
#
# Two hostnames reach the container:
#   {$POSTERBOARD_HOST}  -> the app, every request checked by tinyauth first
#   {$TINYAUTH_HOST}     -> tinyauth's login page
{
	auto_https off
	admin off
	persist_config off
	servers {
		# Only bunny.net's edge can reach the container; trust its X-Forwarded-* headers.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	encode zstd gzip

	# bunny.net forwards plain-http visits too, marked X-Forwarded-Proto: http.
	# Send them to https first, or tinyauth would be asked to return the user
	# to an http address after signing in (and refuse, as a downgrade).
	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} permanent

	@login host {$TINYAUTH_HOST}
	handle @login {
		reverse_proxy 127.0.0.1:{$TINYAUTH_PORT:3000}
	}

	handle /healthz {
		respond "ok" 200
	}

	# Public: the privacy policy and the stylesheet it uses. Never signed in.
	@public path /privacy/ /static/*
	handle @public {
		request_header -Remote-User
		reverse_proxy 127.0.0.1:{$APP_PORT:8000}
	}

	handle {
		# route keeps these in the order written: drop any client-supplied user
		# header first, then let tinyauth set the real one.
		route {
			request_header -Remote-User
			forward_auth 127.0.0.1:{$TINYAUTH_PORT:3000} {
				uri /api/auth/caddy
				copy_headers Remote-User Remote-Name Remote-Email
			}
			request_body {
				max_size 520MB
			}
			reverse_proxy 127.0.0.1:{$APP_PORT:8000} {
				transport http {
					read_timeout 15m
					write_timeout 15m
				}
			}
		}
	}
}
