# Copy to .env for local runs; set these as environment variables in Magic Containers.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTERBOARD_URL=https://posterboard.structuralpython.com
POSTERBOARD_TIME_ZONE=America/Vancouver
# Shown on the public privacy policy as the address for questions.
POSTERBOARD_CONTACT_EMAIL=

# LinkedIn developer app: products "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect".
# Authorized redirect URL on the app: https://posterboard.structuralpython.com/linkedin/callback/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# tinyauth: the login page's own hostname (a subdomain of the app's, so the cookie covers both).
TINYAUTH_APPURL=https://auth.posterboard.structuralpython.com
# user:bcrypt-hash, from `tinyauth user create --username connor --password ... --docker`
TINYAUTH_AUTH_USERS=
POSTERBOARD_HOST=posterboard.structuralpython.com

# Backups: an rclone remote for the bunny.net storage zone, through its S3 API.
# The image sets all of these but the secret.
POSTERBOARD_BACKUP_REMOTE=bunny:posterboard-linkedin
RCLONE_CONFIG_BUNNY_TYPE=s3
RCLONE_CONFIG_BUNNY_PROVIDER=Other
RCLONE_CONFIG_BUNNY_ACCESS_KEY_ID=posterboard-linkedin
RCLONE_CONFIG_BUNNY_FORCE_PATH_STYLE=true
RCLONE_CONFIG_BUNNY_NO_CHECK_BUCKET=true
# The zone's main region, Frankfurt (LA is a replica).
RCLONE_CONFIG_BUNNY_ENDPOINT=https://de-s3.storage.bunnycdn.com
# The storage zone password (Access tab), as is; not obscured.
RCLONE_CONFIG_BUNNY_SECRET_ACCESS_KEY=
